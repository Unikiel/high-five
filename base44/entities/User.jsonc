{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "tutor",
        "assistant",
        "student"
      ],
      "default": "student"
    },
    "avatar_url": {
      "type": "string",
      "description": "Profile avatar image URL"
    },
    "display_name": {
      "type": "string",
      "description": "Custom display name set by user"
    }
  },
  "required": []
}