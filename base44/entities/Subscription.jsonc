{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "plan_name": {
      "type": "string"
    },
    "plan_type": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly",
        "yearly"
      ]
    },
    "price": {
      "type": "number"
    },
    "original_price": {
      "type": "number"
    },
    "discount_percent": {
      "type": "number",
      "default": 0
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "stripe",
        "manual",
        "venmo",
        "zelle",
        "paypal",
        "cashapp",
        "wechat",
        "alipay",
        "other"
      ],
      "default": "stripe"
    },
    "payment_handle": {
      "type": "string",
      "description": "Payment username, email, ID, or short note shown to students"
    },
    "payment_instructions": {
      "type": "string",
      "description": "Manual payment instructions shown to students"
    },
    "stripe_price_id": {
      "type": "string"
    }
  },
  "required": [
    "plan_name",
    "plan_type",
    "price"
  ]
}